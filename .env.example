# HTTP server
REMOTE_DEV_HOST=127.0.0.1
REMOTE_DEV_PORT=8787
REMOTE_DEV_HOST_NAME=local-dev

# Optional. Useful for direct MCP clients. ChatGPT should prefer Secure MCP Tunnel
# or standards-compliant OAuth rather than a custom static API key.
# REMOTE_DEV_TOKEN=change-me

# Downstream Local MCP process.
REMOTE_DEV_DOWNSTREAM_COMMAND=npx
REMOTE_DEV_DOWNSTREAM_ARGS=["-y","@wonderwhy-er/desktop-commander@latest"]
